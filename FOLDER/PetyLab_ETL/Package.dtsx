                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT c.id_cliente AS id_Cliente, c.dni AS dni,
       ISNULL(c.apellido_materno, N'Sin Registro') AS apellidoMa,
       ISNULL(c.apellido_paterno, N'Sin Registro') AS apellidoPa,

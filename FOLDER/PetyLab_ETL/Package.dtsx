              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT m.id_mascota AS id_Mascota, m.nombre AS Nombre,
       CAST(m.fecha_nacimiento AS DATE) AS FechaNac,
       ISNULL(s.descripcion, N'No Especificado') AS Sexo,
       ISNULL(r.nombre_raza, N'General') AS Raza,
       ISNULL(e.nombre_especie, N'Mascota') AS Especie,
       ISNULL(co.descripcion, N'Variado') AS Color
FROM dbo.MASCOTA m
LEFT JOIN dbo.SEXO s ON m.id_sexo = s.id_sexo
LEFT JOIN dbo.RAZA r ON m.id_raza = r.id_raza
LEFT JOIN dbo.ESPECIE e ON r.id_especie = e.id_especie
LEFT JOIN dbo.COLOR co ON m.id_color = co.id_color;</property>
